# ====================================================================
# مؤتمر أكاديمية السلطان قابوس لعلوم الشرطة — متغيرات البيئة
# Conference Portal — Environment Variables
# ====================================================================
# انسخ هذا الملف إلى .env للتطوير المحلي، واضبط القيم في Vercel للنشر.
# Copy this file to .env for local dev, and set these in Vercel for production.
# لا ترفع .env على GitHub — المستودع عام.
# ====================================================================

# --------------------------------------------------------------------
# قاعدة البيانات — PostgreSQL على Neon (استخدم مضيف -pooler)
# Database — PostgreSQL on Neon (use the -pooler host)
# --------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------------------
# المفكّر — DeepSeek
# AI assistant — DeepSeek (https://platform.deepseek.com/api_keys)
# --------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-chat

# --------------------------------------------------------------------
# دخول لوحة الإدارة (/admin) — Basic Auth
# Admin login — set real values in Vercel, never commit them
# --------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --------------------------------------------------------------------
# إشعارات رسائل الدعم الفني (اختياري)
# Support-message notifications (optional)
# --------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# CALLMEBOT_API_KEY=your_callmebot_api_key
# CALLMEBOT_PHONE=your_whatsapp_number
# CONTACT_EMAIL=you@example.com
