# ====================================================================
# مؤتمر أكاديمية السلطان قابوس لعلوم الشرطة — متغيرات البيئة
# Conference Portal — Environment Variables
# ====================================================================
# انسخ هذا الملف إلى .env للتطوير المحلي، واضبط القيم في Vercel للنشر.
# Copy this file to .env for local dev, and set these in Vercel for production.
# ====================================================================

# --------------------------------------------------------------------
# قاعدة البيانات (اختياري — التطبيق لا يستخدم DB حاليًا)
# Database (optional — app doesn't use a DB currently)
# --------------------------------------------------------------------
DATABASE_URL=file:./db/custom.db

# --------------------------------------------------------------------
# أسئلة الجمهور — API خارجي + معرّف الجلسة
# Audience Questions — External API + Session ID
# --------------------------------------------------------------------
# رابط الـ API الخارجي الذي يجلب/يستقبل أسئلة الجمهور
# External questions API base URL (GET + POST + /stream)
AUDIENCE_QUESTIONS_API_URL=https://sqps-qnn.vercel.app/api/questions

# معرّف الجلسة (يصف أي مجموعة أسئلة تُعرض)
# Session ID (determines which question pool is shown)
AUDIENCE_QUESTIONS_SESSION_ID=lecture-101

# --------------------------------------------------------------------
# مفتاح API خارجي (اختياري — فقط إذا كان الـ API يتطلب مصادقة)
# External API key (optional — only if the API requires auth)
# --------------------------------------------------------------------
# AUDIENCE_QUESTIONS_API_KEY=your_secret_token

# --------------------------------------------------------------------
# CallMeBot — إشعارات واتساب للدعم الفني
# CallMeBot — WhatsApp notifications for technical support
# --------------------------------------------------------------------
# يحوّل رسائل زوار الموقع إلى إشعار واتساب يصلك فورًا (لا يرد على الزائر).
# للحصول على المفتاح: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_API_KEY=your_callmebot_api_key
# CALLMEBOT_PHONE=96825656565  (رقمك بالصيغة الدولية بدون +)
