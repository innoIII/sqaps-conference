# ====================================================================
# مؤتمر أكاديمية السلطان قابوس لعلوم الشرطة — متغيرات البيئة
# Conference Portal — Environment Variables
# ====================================================================
# انسخ هذا الملف إلى .env للتطوير المحلي، واضبط القيم في Vercel للنشر.
# Copy this file to .env for local dev, and set these in Vercel for production.
# ====================================================================

# --------------------------------------------------------------------
# قاعدة البيانات (مطلوب لـ Vercel — Prisma Postgres)
# Database (required for Vercel — Prisma Postgres)
# --------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# --------------------------------------------------------------------
# المساعد الذكي — z-ai (الأساسي)
# AI Assistant — z-ai (primary)
# --------------------------------------------------------------------
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=Z.ai

# --------------------------------------------------------------------
# المساعد الذكي — Groq (fallback 1)
# AI Assistant — Groq (fallback 1)
# --------------------------------------------------------------------
# GROQ_API_KEY=your_groq_api_key

# --------------------------------------------------------------------
# المساعد الذكي — OpenRouter (fallback 2)
# AI Assistant — OpenRouter (fallback 2)
# --------------------------------------------------------------------
# OPENROUTER_API_KEY=your_openrouter_api_key

# --------------------------------------------------------------------
# CallMeBot — إشعارات واتساب للدعم الفني
# CallMeBot — WhatsApp notifications for technical support
# --------------------------------------------------------------------
CALLMEBOT_API_KEY=your_callmebot_api_key
CALLMEBOT_PHONE=447312453847

# --------------------------------------------------------------------
# أسئلة الجمهور — API خارجي (اختياري)
# Audience Questions — External API (optional)
# --------------------------------------------------------------------
# AUDIENCE_QUESTIONS_API_URL=https://sqps-qnn.vercel.app/api/questions
# AUDIENCE_QUESTIONS_SESSION_ID=lecture-101
